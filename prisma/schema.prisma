generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  role             UserRole @default(ADMIN)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model HeroSection {
  id        String   @id @default("homepage-hero")
  title     String
  subtitle  String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String
  imageAlt  String?
  updatedAt DateTime @updatedAt

  @@map("hero_sections")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  imageAlt    String?
  linkHref    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("banners")
}

model TextSection {
  id          String   @id @default(cuid())
  key         String   @unique
  heading     String
  body        String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("text_sections")
}

model HomepageImage {
  id          String   @id @default(cuid())
  imageUrl    String
  imageAlt    String?
  caption     String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("homepage_images")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  iconUrl     String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("services")
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String         @db.Text
  woodType    String
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]

  @@index([sortOrder])
  @@index([woodType])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  imageAlt  String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_images")
}
